{% comment %}
  Section: CMONSTER PG1 Product Grid
  Compatible with: Shopify Horizon Theme
  Features: AJAX filtering, sorting, pagination, variant swatches, AJAX add-to-cart
  Section Independence: Fully scoped to section.id -- safe for multiple instance on one page.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link
  href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
  rel="stylesheet"
>

{%- liquid
  assign sid = section.id
  assign products_per_page = section.settings.products_per_page | default: 8
  assign show_rating = section.settings.show_rating
  assign show_vendor = section.settings.show_vendor
  assign show_wishlist = section.settings.show_wishlist
  assign enable_pagination = section.settings.enable_pagination
  assign enable_filtering = section.settings.enable_filtering
  assign enable_sorting = section.settings.enable_sorting
  assign enable_badges = section.settings.enable_badges
  assign cart_behaviour = section.settings.cart_behaviour
-%}

<style>
       #pg1-{{ sid }}{
           --spg-bg: #f8f8f6;
           --spg-surface: #ffffff;
           --spg-ink: #1a1a1a;
           --spg-muted: #7a7a72;
           --spg-accent: #2b4fff;
           --spg-accent2: #ff4d2b;
           --spg-border: #e5e5e0;
           --spg-tag-bg: #eef1ff;
           --spg-tag-ink: #2b4fff;
           --spg-radius: 12px;
           --spg-card-r: 16px;
           --spg-trans: 0.22s cubic-bezier(0.4,0,0.2,1);
           font-family: 'Montserrat', sans-serif;
           background: var(--spg-bg);
           color: var(--spg-ink);
           -webkit-font-smoothing: antialiased;
       }
       .pg1_container{
           padding:0 20px;
           max-width:1480px;
           width:100%;
           margin:0 auto;
       }

       #pg1-{{ sid }} .pg1-toolbar{
            padding: 32px 24px 24px;
           display: flex;
           align-items: center;
           gap: 12px;
           flex-wrap: wrap;
       }

       #pg1-{{ sid }} .pg1-filter-group{
       display: flex;
           gap: 8px;
           flex-wrap: wrap;
           flex: 1;
       }

       #pg1-{{sid }} .pg1-filter-pill {
           padding: 7px 16px;
           border-radius: 99px;
           font-family: 'Montserrat', sans-serif;
           font-size: 12px;
           font-weight: 600;
           letter-spacing: 0.04em;
           border: 1.5px solid var(--spg-border);
           background: var(--spg-surface);
           color: var(--spg-muted);
           cursor: pointer;
           transition: all var(--spg-trans);
       }

       #pg1-{{ sid }} .pg1-filter-pill:hover {
           border-color: var(--spg-accent);
           color: var(--spg-accent);
           }
       #pg1-{{ sid }} .pg1-filter-pill.active {
           background: var(--spg-ink);
           border-color: var(--spg-ink);
           color: #fff;
       }

       #pg1-{{ sid }} #pg1-sort-select {
       padding: 7px 32px 7px 14px;
       font-family: 'Montserrat', sans-serif;
       font-size: 12px;
       font-weight: 600;
       border: 1.5px solid var(--spg-border);
       border-radius: 8px;
       background: var(--spg-surface);
       color: var(--spg-ink);
       cursor: pointer;
       appearance: none;
       background-image:url("https://cdn.shopify.com/s/files/1/0744/7642/1210/files/chevron-down.svg?v=1782474620");
       background-repeat: no-repeat;
       background-position: right 12px center;
       transition: border-color var(--spg-trans);
     }

     #pg1-{{ sid }} .pg1-sort-select:hover { border-color: var(--spg-accent); }
     #pg1-{{ sid }} .pg1-results-count {
       font-size: 12px;
       font-weight: 500;
       color: var(--spg-muted);
       white-space: nowrap;
     }

     /* ── GRID ── */
     #pg1-{{ sid }} .pg1-grid-wrapper {
       max-width: 1340px;
       margin: 0 auto;
       padding: 0 24px 80px;
     }
     #pg1-{{ sid }} .pg1-product-grid {
       display: grid;
       grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
       gap: 24px;
       min-height: 300px;
     }

     #pg1-{{ sid }} .pg1-badges{
       position:absolute;
       top:14px;
       left:14px;
       display:flex;
       flex-direction:column;
       gap:6px;
       z-index:2;
     }

     #pg1-{{sid }} .pg1-badge{
        padding:4px 10px;
        border-radius:6px;
        font-size:700;
        letter-spacing:0.07em;
        text-transform:uppercase;
      }

     #pg1-{{ sid }} .pg1-badge-new   { background: var(--spg-ink); color: #fff; }
     #pg1-{{ sid }} .pg1-badge-sale  { background: var(--spg-accent2); color: #fff; }
     #pg1-{{ sid }} .pg1-badge-sold  { background: rgba(255,255,255,0.85); color: var(--spg-muted); backdrop-filter: blur(4px); }


     {% comment %} #card {% endcomment %}

     #pg1-{{ sid }} .pg1-grid-wrapper{
       width:100%;
       margin: 0 auto;
       padding: 0 24px 80px;

     }

     #pg1-{{ sid }} .pg1-product-grid{
       display:grid;
       grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));
       gap:24px;
       min-height:300px;

     }

     {% comment %} #CARD {% endcomment %}
     /* --spg-trans: 0.22s cubic-bezier(0.4,0,0.2,1); */
     #pg1-{{ sid }} .pg1-card{
       background:var(--spg-surface);
       border-radius:var(--spg-card-r);
       overflow:hidden;
       border:1px solid var(--spg-border);
       transition:transform var(--spg-trans), box-shadow var(--spg-trans);
       cursor:pointer;
       position:relative;
     }

     #pg1-{{ sid }} .pg1-card:hover{
       transform:translate(-4px);
       box-shadow: 0 20px 48px rgba(0,0,0,0.1)
     }

     #pg1-{{ sid }} .pg1-card-body{
      padding: 16px 18px;
    }

     /** #image_slider */

     #pg1-{{ sid }} .pg1-card-media{
         position: relative;
          overflow: hidden;
          aspect-ratio: 3/3.5;
          background: #f0f0ec;
     }

     /** #swatches #options field */

    #pg1-{{ sid }} .pg1-option-group{
      margin-bottom:10px;
    }

     #pg1-{{ sid }} .pg1-option-label {
      font-size:10px; font-weight:600; letter-spacing:0.06em;
      text-transform: uppercase; color:var(--spg-muted); margin-bottom:5px;
    }

     #pg1-{{ sid }} .pg1-swatches{
      display:flex; gap:6px;flex-wrap:wrap;
    }

     #pg1-{{ sid }} .pg1-swatch{
      width: 22px; height: 22px; border-radius: 50%;
      border: 2px solid transparent;
      outline: 1px solid rgba(0,0,0,0.12);
      cursor: pointer;
      transition: border-color var(--spg-trans), outline-color var(--spg-trans), box-shadow var(--spg-trans);
      position: relative; overflow: hidden;
      flex-shrink: 0;
    }

    #pg1-{{ sid }} .pg1-swatch img { width: 100%; height: 100%; object-fit: cover; position:relative; }

    #pg1-{{ sid }} .pg1-swatch:hover{
      outline-color: rgba(0,0,0,0.35);
      box-shadow: 0 0 0 2px var(--spg-surface), 0 0 0 4px var(--spg-ink);
    }

    #pg1-{{ sid }} .pg1-swatch.active {
      outline-color: transparent;
      box-shadow: 0 0 0 2px var(--spg-surface), 0 0 0 4px var(--spg-ink);
    }

    #pg1-{{ sid }} .pg1-swatch.unavailable { opacity: 0.3; cursor:not-allowed; }

    #pg1-{{ sid }} .pg1-swatch.unavailable::after{
      content:""; position:absolute; top:50%; left:0; right:0;
      height:1.5px; background:gray; transform:rotate(-45deg);
    }

    #pg1-{{ sid }} .pg1-text-swatch{
      padding:3px 8px; border-radius:4px; font-size:10px; font-weight:600;
      border:1.5px solid var(--spg-border); cursor:pointer;background:#fff;
    }

    #pg1-{{ sid }} .pg1-text-swatch.active { border-color: var(--spg-ink); background: var(--spg-ink); color: #fff; }
    #pg1-{{ sid }} .spg-text-swatch.unavailable { opacity: 0.4; cursor: not-allowed; text-decoration: line-through; }

    /* #price_css */

   #pg1-{{sid }} .pg1-card-price{
    display:flex; align-items:center; gap:8px; margin-bottom:8px;
  }

   #pg1-{{sid }} .pg1-price-current{
     font-size: 16px; font-weight: 700; color: var(--spg-ink);
   }

  #pg1-{{sid }}  .pg1-price-original {
  font-size: 13px; font-weight: 400; color: var(--spg-muted); text-decoration: line-through;
  }

   #pg1-{{sid }} .pg1-compare {}

   #pg1-{{sid }} .pg1-price-save {
   font-size: 11px; font-weight: 700; color: var(--spg-accent2);
  }

  #pg1-{{ sid }} .spg-card-tag {
    display: inline-block; padding: 3px 10px; border-radius: 6px;
    background: var(--spg-tag-bg); color: var(--spg-tag-ink); font-size: 10px;
    font-weight: 700; letter-spacing: 0.05em;
  }

    #pg1-{{ sid }} .pg1-text-swatch{}


    /* #SKELETON */


   #pg1-{{sid }} .pg1-skeleton{
      background:var(--spg-surface);
      border-radius:var(--spg-card-r);
      overflow:hidden;
      border:1px solid var(--spg-border);
  }
   #pg1-{{sid }} .pg1-skeleton-media {
    aspect-ratio:3/3.5;
    background:linear-gradient(90deg, #f0f0ec 25%, #e8e8e4 50%, #f0f0ec 75%);
    background-size:200% 100%;
    animation:pg1-shimmer-{{ sid }} 1.4s infinite;
  }
   #pg1-{{sid }} .pg1-skeleton-line.w80 {
    width:80%;
  }
   #pg1-{{sid }} .pg1-skeleton-line.w60 {
    width:60%;
  }
   #pg1-{{sid }} .pg1-skeleton-line.w40 {
    width:40%;
  }

  @keyframes pg1-shimmer-{{ sid }} {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  {% comment %} #addtocard {% endcomment %}

  #pg1-{{ sid }} .pg1-quick-add {
    position:absolute;
    bottom:0; left:0;right:0;
    padding:12px;
    {% comment %} transform:translateY(100%); {% endcomment %}
    transition:transform var(--spg-trans);
    z-index:3;
  }

  #pg1-{{ sid }} .pg1-card:hover .pg1-quick-add { transform:translateY(0); }


  #pg1-{{ sid }} .pg1-quick-add-btn {
    width:100%;
    padding:11px;
    background: rgba(26,26,26,0.9);
    backdrop-filter: blur(8px);
     color: #fff;
    border: none;
    border-radius: 8px;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background var(--spg-trans);
  }

  #pg1-{{ sid }} .pg1-quick-add-btn:hover   { background: var(--spg-accent); }
  #pg1-{{ sid }} .pg1-quick-add-btn.added   { background: #1a8f5a; }
  #pg1-{{ sid }} .pg1-quick-add-btn.loading { background: #555; cursor: wait; }
  #pg1-{{ sid }} .pg1-quick-add-btn[disabled] { opacity: 0.5; cursor: not-allowed; }
  #pg1-{{ sid }} .pg1-quick-add-btn.sold-out { background: rgba(100,100,100,0.8); cursor: not-allowed; }


       /* phase 2 css goes here */
</style>

<div id="pg1-{{ section.id }}">
  <div class="pg1_container">
    {% comment %} TOOLBAR {% endcomment %}
    <div class="pg1-toolbar">
      {% if enable_filtering == true %}
        <div class="pg1-filter-group" data-pg1-filter-group>
          <button class="pg1-filter-pill active" data-pg1-filter="__all">All</button>
          {% for block in section.blocks %}
            {% if block.type == 'collection' %}
              {% assign col_handle = block.settings.collection %}

              {% if col_handle != blank and col_handle != null %}
                {% assign col = collections[col_handle] %}
                {% if col != blank %}
                  <button
                    class="pg1-filter-pill"
                    data-pg1-filter="{{ col.handle }}"
                    data-pg1-collection-title="{{ col.title }}"
                  >
                    {{ col.title }}
                  </button>
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
        {% comment %} enable_filtering {% endcomment %}
      {% endif %}
      {% comment %} SORTING {% endcomment %}
      {% if enable_sorting %}
        <select id="pg1-sort-select" data-pg1-sort-select>
          <option value="featured">Featured</option>
          <option value="price-asceding">Price Low to High</option>
          <option value="price-descending">Price High to Low</option>
          <option value="created-descending">Newest</option>
        </select>
      {% endif %}
      {% comment %} #product_count {% endcomment %}
      <span class="spg-results-count" data-pg1-results-count></span>
    </div>
    {% comment %} TOOBAR ENDS UP {% endcomment %}
    {% comment %} PRODUCT GRID {% endcomment %}
    <div class="pg1-grid-wrapper">
      <div class="pg1-product-grid" data-pg1-product-grid>
        {% comment %} server-side initial render for seo {% endcomment %}
        {%- assign all_products = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign col_handle = block.settings.collection -%}
            {%- if col_handle != blank and col_handle != null -%}
              {%- assign col = collections[col_handle] -%}
              {%- if col != blank -%}
                {%- for product in col.products limit: products_per_page -%}
                  {% comment %}
                    {%- render 'spg-product-card',
                    product: product,
                    sid: sid,
                    show_rating: show_rating,
                    show_vendor: show_vendor,
                    show_wishlist: show_wishlist,
                    enable_badges: enable_badges,
                    collection_handle: col.handle
                    -%}
                  {% endcomment %}
                  {% comment %}
                    <div class="pg1-skeleton">
                      <div class="pg1-skeleton-media"></div>
                      <div class="pg1-skeleton-body">
                        <div class="pg1-skeleton-line w80"></div>
                        <div class="pg1-skeleton-line w60"></div>
                        <div class="g1-skeleton-line w40"></div>
                      </div>
                    </div>
                  {% endcomment %}
                  <div>
                  <h4>  {{product.title }} </h4>
                    {%- for option in product.options_with_values -%}
                      {% if option.name == 'Color' %}
                         {% for value in option.values %}
                         
                           <label>
                              {{ value.name }}
                              {% assign bg_color = value.name %} <br>
                              {% if value.swatch.color != null %}
                                {% assign bg_color = value.swatch.color %}
                              {% endif %}
                              <input type="radio" readonly name="{{option.name }}"
                                 value="{{value.name }}" style="width:20px;height:20px;border-radius:50%;background:{{bg_color }}" > 
                           </label>
                          
                         {% endfor %}
                      {% endif %}
                    {%- endfor -%}
                  </div>

                  <div style="display:none;" aria-hidden="true">
                    {% render 'pg1-product-card',
                      product: product,
                      sid: sid,
                      isAvailable: product.available,
                      variant: product.selected_or_first_available_variant,
                      show_rating: show_rating,
                      show_vendor: show_vendor,
                      show_wishlist: show_wishlist,
                      enable_badges: enable_badges,
                      collection_handle: col.handle
                    %}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor %}
      </div>
    </div>
    {% if enable_pagination %}
      <div class="pg1-pagination" data-pg1-pagination></div>
    {% endif %}
  </div>
  {% comment %} #phase:4 data bridge {% endcomment %}

  <script type="application/json" id="pg1-data-{{ sid }}">
    {
        "sectionId":         {{ sid | json }},
        "productsPerPage":   {{ products_per_page }},
        "showRating":       {{ show_rating | json }},
        "showVendor":       {{ show_vendor | json }},
        "showWishList":     {{ show_wishlist | json   }},
        "enablePagination": {{ enable_pagination | json }},
        "enableFiltering":  {{ enable_filtering | json }},
        "enableSorting":    {{ enable_sorting | json }},
        "enableBadges":     {{ enable_badges | json }},
        "cartBehaviours":   {{  cart_behaviour | json }},
        "collections":[
            {% assign first_col = true %}
            {% for block in section.blocks %}
                {% if block.type == 'collection' %}
                    {% assign col_handle = block.settings.collection %}
                    {% if col_handle != blank and col_handle != nil %}
                      {% assign col = collections[col_handle] %}
                      {% if col != blank %}
                        {% unless first_col %}, {% endunless %} {% comment %} explain this line why use it and why first_col = false {% endcomment %}

                        {% assign first_col = false %}
                        {
                            "handle": {{  col.handle | json }},
                            "title" : {{  col.title | json }},
                            "products": [
                                {% for product in col.products %}
                                    {% unless forloop.first %}, {% endunless %}
                                    {

                                        "id":           {{ product.id }},
                                        "handle":       {{ product.handle | json }},
                                        "title":        {{ product.title | json }},
                                        "vendor":       {{ product.vendor | json }},
                                        "url":          {{ product.url | json }},
                                        "available":    {{ product.available | json }},
                                        "price":        {{ product.price | json }},
                                        "compareAtPrice":{{ product.compare_at_price | default: 'null' }},
                                        "collectionHandle":{{ col.handle | json }},
                                        "tags":           {{  product.tags | json }},
                                        "featuredImage": {{ product.featured_image | img_url:'600x' | json  }},
                                         "images": [
                                            {%- for image in product.images limit: 5 -%}
                                            {%- unless forloop.first %},{%- endunless %} {% comment %} what is this unless what does it meand and what is this comma, and how forloop.first is false help  {% endcomment %}
                                            {{ image | img_url: '600x' | json }}
                                            {%- endfor %}
                                        ],
                                        "options":      {{ product.options | json }},
                                        "variants": [
                                            {% for variant in product.variants %}
                                              {% unless forloop.first %},    {% endunless %}
                                              {
                                                "id":              {{  variant.id }},
                                                "title":           {{  variant.title | json }},
                                                "available":       {{  variant.available | json }},
                                                "price":           {{ variant.price }},
                                                "compareAtPrice":  {{ variant.compare_at_price | default: 'null' }},
                                                "option1":         {{ variant.option1 | json }},
                                                "option2":         {{ variant.option2 | json }},
                                                "option3":         {{ variant.option3 | json }},
                                                "featuredImage":  {{ variant.image | img_url: '600x' | default: '' | json }}
                                              }
                                            {% endfor %}
                                        ]
                                    }
                                {% endfor %}
                            ]
                        }
                      {% endif %}
                    {% endif %}
                {% endif %}

            {% endfor %}
        ]
    }
  </script>

  <div id="pg1-toast-{{ sid }}"></div>
</div>

<script>
  // Phase 4: javascipt goes above
  // IFFE
  (function () {
    // 7.1
    // 1. Read config

    const CONFIG = JSON.parse(document.getElementById('pg1-data-{{ sid }}').textContent);

    const SID = CONFIG.sectionId;

    // -- 2. DOM. refs ( ALL through root -- never through document )

    const root = document.getElementById('pg1-' + SID);
    const gridEl = root.querySelector('[data-pg1-product-grid]');
    const filterGroup = root.querySelector('[data-pg1-filter-group]');
    const sortSelect = root.querySelector('[data-pg1-sort-select]');
    const resultsCount = root.querySelector('[data-pg1-results-count]');
    const paginationEl = root.querySelector('[data-pg1-pagination]');
    const toastEl = document.getElementById('spg-toast-' + SID);

    // console.log(paginationEl);

    // 7.2 Define State
    // -- 3. State #state
    let activeFilter = '__all';
    let activeSort = 'featured';
    let currentPage = 1;
    let wishlisted = new Set();
    let cardVariants = {}; // { productId: variantIndex}
    let cardSlides = {}; // { productId: slideIndex }
    let toastTimer = null;

    // 7.3 Build in-memory product list
    // 4. In-memory data --
    const allProducts = [];
    const seenIds = new Set();

    CONFIG.collections.forEach((col) => {
      col.products.forEach((p) => {
        if (!seenIds.has(p.id)) {
          seenIds.add(p.id);
          allProducts.push(p);
        }
      });
    });

    //console.log(allProducts)

    // 7.4 Write helpers
    // -- 5. Helpers --
    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function starsHTML(rating) {
      return Array.from(
        { length: 5 },
        (_, i) =>
          `<svg viewBox="0 0 12 12" fill="${i < Math.round(rating) ? '#FBBC04' : '#ddd'}">
              <path d="M6 1l1.39 2.82 3.11.45-2.25 2.19.53 3.1L6 8 3.22 9.56l.53-3.1L1.5 4.27l3.11-.45z"/>
          </svg>`
      ).join('');
    }

    // 7.5 Write the data pipeline

    // -- 6 Data Pipeline

    function getProductList() {
      let list;

      if (activeFilter === '__all') {
        list = [...allProducts];
      } else {
        list = allProducts.filter((p) => p.collectionHandle === activeFilter);
      }

      switch (activeSort) {
        case 'price-asceding':
          list.sort((a, b) => a.price - b.price);
          break;
        case 'price-descending':
          list.sort((a, b) => b.price - a.price);
          break;
        case 'created-descending':
          list.reverse();
          break;
      }
      return list;
    }

    function getPagedList(list) {
      if (!CONFIG.enablePagination) return list;
      const start = (currentPage - 1) * CONFIG.productsPerPage;
      return list.slice(start, start + CONFIG.productsPerPage);
    }

    // console.log("get-product-list:--",  getProductList());
    // console.log("getPagedList:",getPagedList(getProductList()))

    // 7.6. Card Builder
    // -- 7 Card Builder
    function buildCardHTML(product) {
      // 7a. Resolve active variant
      const varIdx = cardVariants[product.id] ?? 0; // set as empty object
      const variant = product.variants[varIdx] || product.variants[0];
      const price = variant ? variant.price : product.price;
      const compareAt = variant ? variant.compareAtPrice : product.compareAtPrice;
      const isAvailable = variant ? variant.available : product.available;
      const isSale = compareAt && compareAt > price;

      // 7b. Images
      const images = product.images.length ? product.images : [product.featuredImage];
      // console.log(product.images)

      const slideIdx = cardSlides[product.id] || 0;

      // 7c. Build each part as its own variable

      const badgesHTML = buildBadgeHTML(product, variant, isAvailable, isSale);
      const slidesHTML = buildSlidesHTML(images, product);
      const arrowsHTML = buildArrowsHTML(images, slideIdx);
      const optionsHTML = buildOptionsHTML(product, variant);
      const priceHTML = buildPriceHTML(price, compareAt, isSale);
      const wishlistHTML = CONFIG.showWishlist ? `<button class="spg-wishlist-btn" data-wishlist-btn>♡</button>` : '';

      const atcLabel = isAvailable ? '+ Add to Cart' : 'Sold Out';
      const actClass = isAvailable ? '' : 'sold-out';

      //  console.log(product);

      // 7d. Assemble
      return `
             <article class="pg1-card" data-pg1-product-id="${product.id}" data-pg1-variant-id="${variant?.id || ''}">
                <div class="pg1-card-media">
                    <div class="pg1-slider" data-pg1-slider style="transform:translateX(-${slideIdx * 100}%)">
                        ${slidesHTML}
                    </div>
                    <div class="pg1-badges">${badgesHTML}</div>
                    ${arrowsHTML}
                    ${wishlistHTML}
                    <div class="pg1-quick-add">
                        <form method="post" action="/cart/add" novalidate data-pg1-atc-form>
                        <input type="hidden" name="form_type" value="product">
                        <input type="hidden" name="id" value="${variant?.id || ''}" data-variant-input>
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" name="add"
                            class="pg1-quick-add-btn {atcClass}"
                            data-pg1-atc-btn
                            ${!isAvailable ? 'disabled' : ''}>
                            ${atcLabel}
                        </button>
                        </form>
                    </div>
                </div>
                <div class="pg1-card-body">
                    <a href="${product.url}" class="pg1-card-link">
                        ${CONFIG.showVendor ? `<p class="spg-card-brand">${product.vendor}</p>` : ''}
                        <p class="spg-card-title">${product.title}</p>
                    </a>
                    ${optionsHTML}
                    ${priceHTML}
                </div>
            </article>  
      `;

      /*********** buildCardHTML **************/
    }

    // helper functions:

    function buildBadgeHTML(product, variant, isAvailable, isSale) {
      if (!CONFIG.enableBadges) return '';
      if (!isAvailable) return `<span class="pg1-badge pg1-badge-sold" > Sold Out </span>`; // product is not available
      if (isSale) return `<span class="pg1-badge pg1-badge-sale">Sale </span>`;
      if (product.tags?.includes('new')) return `<span class="pg1-badge pg1-badge-new"> New </span>`;
      return '';
    }

    function buildSlidesHTML(images, product) {
      //  console.log('buildSlidesHTML',images)
      return images
        .map((url) => {
          return `
            <div class="pg1-slide">
                <a href="${product.url}"> 
                    <img src="${url}" alt="${product.title}" loading="lazy" >
                </a>
            </div>
        `;
        })
        .join('');
      //  return `slide html`;
    }

    function buildArrowsHTML(images, slideIdx) {
      // if (images.length <= 1) return '';
      return `
      <button class="pg1-slider-arrow prev" data-pg1-slide-prev ${slideIdx === 0 ? 'disabled' : ''}>‹</button>
      <button class="pg1-slider-arrow next" data-pg1-slide-next ${
        slideIdx >= images.length - 1 ? 'disabled' : ''
      }>›</button>`;
    }

    function buildOptionsHTML(product, variant) {
      if (!product.options?.length) return '';
      if (product.options.length === 1 && product.options[0] === 'Title') return '';

      //   console.log('----', product.options);
      // console.log('product variants:', product.variants);
      return product.options
        .map((optName, index) => {
          const values = [...new Set(product.variants.map((v) => v['option' + (index + 1)]).filter(Boolean))];
          const isColor = /color|colour/i.test(optName);
          const swatchesHTML = values
            .map((val) => {
              // Check if any variant with this option value is available
              const variantsWithVal = product.variants.filter((v) => v['option' + (index + 1)] === val);
              const anyAvailable = variantsWithVal.some((v) => v.available);
              const isActive = variant && variant['option' + (index + 1)] === val;

              if (isColor) {
                // Use CSS background color as fallback (Shopify metafields can provide swatch images, but we use color name here)
                return `<span class="pg1-swatch ${isActive ? 'active' : ''} ${!anyAvailable ? 'unavailable' : ''}"
                      style="background:${val.toLowerCase().replace(/\s+/g, '')}"
                      title="${val}"
                      data-opt-idx="${index}"
                      data-opt-val="${val}"></span>`;
              } else {
                return `<span class="pg1-text-swatch ${isActive ? 'active' : ''} ${!anyAvailable ? 'unavailable' : ''}"
                      data-opt-idx="${index}"
                      data-opt-val="${val}">${val}</span>`;
              }
            })
            .join('');
          /* ‍swatcHTML endsh here */

          return `
              <div class="pg1-option-group">
                <div class="pg1-option-label">${optName}</div>
                <div class="pg1-swatches">${swatchesHTML}</div>
              </div>`;
        })
        .join('');
    }

    function buildPriceHTML(price, compareAt, isSale) {
      const discount = isSale ? Math.round((1 - price / compareAt) * 100) : 0;
      return `
        <div class="pg1-card-price">
          <span class="pg1-price-current" data-pg1-price>
            ${formatMoney(price)} 
            ${
              isSale
                ? `<span class="pg1-price-original" data-pg1-compare>${formatMoney(compareAt)}</span>
                  <span class="pg1-price-save">−${discount}%</span>`
                : '<span data-pg1-compare style="display:none"></span>'
            }
           
          </span>
        </div>
      `;
    }

    // 7.7 Write renderGrid and renderPagination
    // -- 8. render
    function renderSkeletons() {
      gridEl.innerHTML = Array.from(
        { length: CONFIG.productsPerPage },
        () => `
      <div class="pg1-skeleton">
        <div class="pg1-skeleton-media"></div>
        <div class="pg1-skeleton-body">
          <div class="pg1-skeleton-line w80"></div>
          <div class="pg1-skeleton-line w60"></div>
          <div class="g1-skeleton-line w40"></div>
        </div>
      </div>`
      ).join('');
    }

    {% comment %} 
        
    {% endcomment %}

    // render grid

    function renderGrid() {
      const fullList = getProductList();
      const pagedList = getPagedList(fullList);

      // update count
      if (resultsCount) {
        resultsCount.textContent = `${fullList.length} product${fullList.length !== 1 ? 's' : ''}`;
      }

      // Render card or empty state

      if (pagedList.length === 0) {
        gridEl.innerHTML = `
          <div class="pg1-empty">
            <div class="pg1-empty-icon">🔍</div>
            <h3>No products found</h3>
            <p>Try a different filter.</p>
          </div>
        `;
      } else {
        // below code is doing everything
        gridEl.innerHTML = pagedList.map((p) => buildCardHTML(p)).join('');

        bindCardEvents();
      }

      //  consol.log(enablePagination);

      if (CONFIG.enablePagination && paginationEl) {
        renderPagination(fullList.length);
      } else {
        paginationEl.innerHTML = 'No pagiantion';
      }
    } // render grid

    // #renderPagination
    function renderPagination(totalCount) {
      const total = Math.ceil(totalCount / CONFIG.productsPerPage);
      if (total <= 1) {
        paginationEl.innerHTML = '';
        return;
      }
      let html = '';

      html += `<button class="pg1-page-btn" data-pg1-page-prev  ${currentPage === 1 ? 'disabled' : ''} > 
       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>`;

      for (let i = 1; i <= total; i++) {
        html += `<button class="pg1-page-btn ${
          i === currentPage ? 'active' : ''
        }" data-pg1-page="${i}"  > ${i}  </button>`;
      }

      html += `
      <button class="pg1-page-btn" data-pg1-page-next ${currentPage === total ? 'disabled' : ''}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>`;

      paginationEl.innerHTML = html;

      paginationEl.querySelectorAll('[data-pg1-page]').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentPage = parseInt(btn.dataset.pg1Page);
          console.log('pagination clicked');
          renderGrid();
          root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      const prevBtn = paginationEl.querySelector('[data-pg1-page-prev]');
      const nextBtn = paginationEl.querySelector('[data-pg1-page-next]');
      if (prevBtn)
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            renderGrid();
            root.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      if (nextBtn)
        nextBtn.addEventListener('click', () => {
          if (currentPage < total) {
            currentPage++;
            renderGrid();
            root.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
    } // -- renderPagination

    // optional #update_url

    // #bind-card-level-events

    function bindCardEvents() {
      gridEl.querySelectorAll('.pg1-card').forEach((card) => {
        // data-pg1-product-id
        const pid = parseInt(card.dataset.pg1ProductId); // data-pg1-product-id
        const product = allProducts.find((p)=> p.id === pid);
        if(!product) return;
       
        const images   = product.images.length ? product.images : [product.featuredImage];
        const sliderEl =  card.querySelector('[data-pg1-slider]'); // data-pg1-slider

        // slider Arrows





      });
    } // bindCardEvents


    {% comment %} ************************************ {% endcomment %}
    // ##renderGrid();
  //  renderGrid();

    /****************************************************************/
    //// IFFE ENDS HERE
  })();
</script>

