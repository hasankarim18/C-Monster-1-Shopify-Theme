  <div id="pg1-toast-{{ sid }}"></div>
</div>

<script>
  // Phase 4: javascipt goes above
  // IFFE
  (function () {
    // 7.1
    // 1. Read config

    const CONFIG = JSON.parse(document.getElementById('pg1-data-{{ sid }}').textContent);

    const SID = CONFIG.sectionId;

    // -- 2. DOM. refs ( ALL through root -- never through document )

    const root = document.getElementById('pg1-' + SID);
    const gridEl = root.querySelector('[data-pg1-product-grid]');
    const filterGroup = root.querySelector('[data-pg1-filter-group]');
    const sortSelect = root.querySelector('[data-pg1-sort-select]');
    const resultsCount = root.querySelector('[data-pg1-results-count]');
    const paginationEl = root.querySelector('[data-pg1-pagination]');
    const toastEl = document.getElementById('pg1-toast-' + SID);

    // console.log(paginationEl);

    // 7.2 Define State
    // -- 3. State #state
    let activeFilter = '__all';
    let activeSort = 'featured';
    let currentPage = 1;
    let wishlisted = new Set();
    let cardVariants = {}; // { productId: variantIndex}
    let cardSlides = {}; // { productId: slideIndex }
    let toastTimer = null;

    // 7.3 Build in-memory product list
    // 4. In-memory data --
    const allProducts = [];
    const seenIds = new Set();

    CONFIG.collections.forEach((col) => {
      col.products.forEach((p) => {
        if (!seenIds.has(p.id)) {
          seenIds.add(p.id);
          allProducts.push(p);
        }
      });
    });

    //console.log(allProducts)

    // 7.4 Write helpers
    // -- 5. Helpers --
    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function starsHTML(rating) {
      return Array.from(
        { length: 5 },
        (_, i) =>
          `<svg viewBox="0 0 12 12" fill="${i < Math.round(rating) ? '#FBBC04' : '#ddd'}">
              <path d="M6 1l1.39 2.82 3.11.45-2.25 2.19.53 3.1L6 8 3.22 9.56l.53-3.1L1.5 4.27l3.11-.45z"/>
          </svg>`
      ).join('');
    }

    // 7.5 Write the data pipeline

    // -- 6 Data Pipeline

    function getProductList() {
      let list;

      if (activeFilter === '__all') {
        list = [...allProducts];
      } else {
        list = allProducts.filter((p) => p.collectionHandle === activeFilter);
      }

      switch (activeSort) {
        case 'price-asceding':
          list.sort((a, b) => a.price - b.price);
          break;
        case 'price-descending':
          list.sort((a, b) => b.price - a.price);
          break;
        case 'created-descending':
          list.reverse();
          break;
      }
      return list;
    }

    function getPagedList(list) {
      if (!CONFIG.enablePagination) return list;
      const start = (currentPage - 1) * CONFIG.productsPerPage;
      return list.slice(start, start + CONFIG.productsPerPage);
    }

    // console.log("get-product-list:--",  getProductList());
    // console.log("getPagedList:",getPagedList(getProductList()))

    // 7.6. Card Builder
    // -- 7 Card Builder
    function buildCardHTML(product) {
      // 7a. Resolve active variant
      const varIdx = cardVariants[product.id] ?? 0; // set as empty object
      const variant = product.variants[varIdx] || product.variants[0];
      const price = variant ? variant.price : product.price;
      const compareAt = variant ? variant.compareAtPrice : product.compareAtPrice;
      const isAvailable = variant ? variant.available : product.available;
      const isSale = compareAt && compareAt > price;

      // 7b. Images
      const images = product.images.length ? product.images : [product.featuredImage];
      // console.log(product.images)

      const slideIdx = cardSlides[product.id] || 0;

      // 7c. Build each part as its own variable

      const badgesHTML = buildBadgeHTML(product, variant, isAvailable, isSale);
      const slidesHTML = buildSlidesHTML(images, product);
      const arrowsHTML = buildArrowsHTML(images, slideIdx);
      const optionsHTML = buildOptionsHTML(product, variant);
      const priceHTML = buildPriceHTML(price, compareAt, isSale);
      const wishlistHTML = CONFIG.showWishlist ? `<button class="spg-wishlist-btn" data-wishlist-btn>♡</button>` : '';

      const atcLabel = isAvailable ? '+ Add to Cart' : 'Sold Out';
      const actClass = isAvailable ? '' : 'sold-out';

      //  console.log(product);

      // 7d. Assemble
      return `
             <article class="pg1-card" data-pg1-product-id="${product.id}" data-pg1-variant-id="${variant?.id || ''}">
                <div class="pg1-card-media">
                    <div class="pg1-slider" data-pg1-slider style="transform:translateX(-${slideIdx * 100}%)">
                        ${slidesHTML}
                    </div>
                    <div class="pg1-badges">${badgesHTML}</div>
                    ${arrowsHTML}
                    ${wishlistHTML}
                    <div class="pg1-quick-add">
                        <form method="post" action="/cart/add" novalidate data-pg1-atc-form>
                        <input type="hidden" name="form_type" value="product">
                        <input type="hidden" name="id" value="${variant?.id || ''}" data-pg1-variant-input>
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" name="add"
                            class="pg1-quick-add-btn {atcClass}"
                            data-pg1-atc-btn
                            ${!isAvailable ? 'disabled' : ''}>
                            ${atcLabel}
                        </button>
                        </form>
                       
                    </div>
                </div>
                <div class="pg1-card-body">
                    <a href="${product.url}" class="pg1-card-link">
                        ${CONFIG.showVendor ? `<p class="spg-card-brand">${product.vendor}</p>` : ''}
                        <p class="spg-card-title">${product.title}</p>
                    </a>
                    ${optionsHTML}
                    ${priceHTML}
                </div>
            </article>  
      `;

      /*********** buildCardHTML **************/
    }

    // helper functions:

    function buildBadgeHTML(product, variant, isAvailable, isSale) {
      if (!CONFIG.enableBadges) return '';
      if (!isAvailable) return `<span class="pg1-badge pg1-badge-sold" > Sold Out </span>`; // product is not available
      if (isSale) return `<span class="pg1-badge pg1-badge-sale">Sale </span>`;
      if (product.tags?.includes('new')) return `<span class="pg1-badge pg1-badge-new"> New </span>`;
      return '';
    }

    function buildSlidesHTML(images, product) {
      //  console.log('buildSlidesHTML',images)
      return images
        .map((url) => {
          return `
            <div class="pg1-slide">
                <a href="${product.url}"> 
                    <img src="${url}" alt="${product.title}" loading="lazy" >
                </a>
            </div>
        `;
        })
        .join('');
      //  return `slide html`;
    }

    function buildArrowsHTML(images, slideIdx) {
      // if (images.length <= 1) return '';
      const leftChevron = "https://cdn.shopify.com/s/files/1/0744/7642/1210/files/left-chevron.png?v=1783058096"
      const rightChevron = "https://cdn.shopify.com/s/files/1/0744/7642/1210/files/right-chevron.png?v=1783058096"
      return `
      <button class="pg1-slider-arrow prev" data-pg1-slide-prev ${slideIdx === 0 ? 'disabled' : ''}>
        <img style="width:20px;height:20px;" src="${leftChevron}" loading="lazy">
      </button>
      <button class="pg1-slider-arrow next" data-pg1-slide-next ${
        slideIdx >= images.length - 1 ? 'disabled' : ''
      }>
         <img style="width:20px;height:20px;" src="${rightChevron}" loading="lazy">
      </button>`;
    }
     

    // #buildOptionsHTML 
  function buildOptionsHTML(product, variant) {
  if (!product.options?.length) return '';
  if (product.options.length === 1 && product.options[0] === 'Title') return '';

  return product.options_with_values
    .map((optName, index) => {
      const values = [
        ...new Set(
          product.variants
            .map(v => v['option' + (index + 1)])
            .filter(Boolean)
        )
      ];

      let swatchesHTML = '';

      if (/color|colour/i.test(optName.name)) {
        swatchesHTML = product.options_with_values_details
          .map((details) => {
              
          return  details.values.map((val)=>{
                    const variantsWithVal = product.variants.filter(
                    v => v['option' + (index + 1)] === val.name
                  );                
              //    console.log(val.swatch.color)
                  const anyAvailable = variantsWithVal.some(v => v.available);
                  const isActive =
                    variant && variant['option' + (index + 1)] === val.name;                   
              // console.log(val)
                if(val.type == 'Color'){
                
                
                  if(val.swatch_color === '' && val.swatch_image === ''){
                     return `
                     <span class="pg1-swatch-item">
                          <span
                              class="${isActive ? 'active' : ''} ${!anyAvailable ? 'unavailable' : ''}"
                              style="background:${val.swatch_color || val.name}"
                              data-pg1-opt-idx="${index}"
                              data-pg1-opt-val="${val.name}">
                          </span>

                          <span>${val.name}</span>
                      </span>
                    `; 
                  }else if(val.swatch_color !== '' && val.swatch_image !== ''){
                    return `
                    <span class="pg1-swatch-item">
                        <span
                            class="${isActive ? 'active' : ''} ${!anyAvailable ? 'unavailable' : ''}"
                            data-pg1-opt-idx="${index}"
                            data-pg1-opt-val="${val.name}">
                            <img src="${val.swatch_image}" alt="${val.name}">
                        </span>

                        <span>${val.name}</span>
                    </span>
                    `; 
                  }else{
                     return `
                    <span class="pg1-swatch-item">
                        <span
                            class="${isActive ? 'active' : ''} ${!anyAvailable ? 'unavailable' : ''}"
                            style="background:${val.swatch_color || val.name}"
                            data-pg1-opt-idx="${index}"
                            data-pg1-opt-val="${val.name}">
                        </span>

                        <span>${val.name}</span>
                    </span>
                    `; 
                  }

                 
                }// val.type

                })
                .join('');
            
       }).join("")
          
      } else {
        swatchesHTML = values
          .map((val) => {
            const variantsWithVal = product.variants.filter(
              v => v['option' + (index + 1)] === val
            );

            const anyAvailable = variantsWithVal.some(v => v.available);
            const isActive =
              variant && variant['option' + (index + 1)] === val;

            return `
              <span
                class="pg1-text-swatch ${isActive ? 'active' : ''} ${!anyAvailable ? 'unavailable' : ''}"
                data-pg1-opt-idx="${index}"
                data-pg1-opt-val="${val}">
                ${val}
              </span>
            `;
          })
          .join('');
      }

      return `
        <div class="pg1-option-group">
          <div class="pg1-option-label">${optName.name}</div>
          <div class="pg1-swatches">${swatchesHTML}</div>
        </div>
      `;
    })
    .join('');
}
    function buildPriceHTML(price, compareAt, isSale) {
      const discount = isSale ? Math.round((1 - price / compareAt) * 100) : 0;
      return `
        <div class="pg1-card-price">
          <span class="pg1-price-current" data-pg1-price>
            ${formatMoney(price)}      
           
          </span>
           ${
              isSale
                ? `<span class="pg1-price-original" data-pg1-compare>${formatMoney(compareAt)}</span>
                  <span class="pg1-price-save">−${discount}%</span>`
                : '<span data-pg1-compare style="display:none"></span>'
            }
        </div>
      `;
    }

    // 7.7 Write renderGrid and renderPagination
    // -- 8. render
    function renderSkeletons() {
      gridEl.innerHTML = Array.from(
        { length: CONFIG.productsPerPage },
        () => `
      <div class="pg1-skeleton">
        <div class="pg1-skeleton-media"></div>
        <div class="pg1-skeleton-body">
          <div class="pg1-skeleton-line w80"></div>
          <div class="pg1-skeleton-line w60"></div>
          <div class="g1-skeleton-line w40"></div>
        </div>
      </div>`
      ).join('');
    }

    {% comment %} 
        
    {% endcomment %}

    // render grid

    function renderGrid() {
      const fullList = getProductList();
      const pagedList = getPagedList(fullList);

      // update count
      if (resultsCount) {
        resultsCount.textContent = `${fullList.length} product${fullList.length !== 1 ? 's' : ''}`;
      }

      // Render card or empty state

      if (pagedList.length === 0) {
        gridEl.innerHTML = `
          <div class="pg1-empty">
            <div class="pg1-empty-icon">🔍</div>
            <h3>No products found</h3>
            <p>Try a different filter.</p>
          </div>
        `;
      } else {
        // below code is doing everything
        gridEl.innerHTML = pagedList.map((p) => buildCardHTML(p)).join('');

        bindCardEvents();
      }

      //  consol.log(enablePagination);

      if (CONFIG.enablePagination && paginationEl) {
        renderPagination(fullList.length);
      } else {
        paginationEl.innerHTML = 'No pagiantion';
      }
    } // render grid

    // #renderPagination
    function renderPagination(totalCount) {
      const total = Math.ceil(totalCount / CONFIG.productsPerPage);
      if (total <= 1) {
        paginationEl.innerHTML = '';
        return;
      }
      let html = '';

      html += `<button class="pg1-page-btn" data-pg1-page-prev  ${currentPage === 1 ? 'disabled' : ''} > 
       <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>`;

      for (let i = 1; i <= total; i++) {
        html += `<button class="pg1-page-btn ${
          i === currentPage ? 'active' : ''
        }" data-pg1-page="${i}"  > ${i}  </button>`;
      }

      html += `
      <button class="pg1-page-btn" data-pg1-page-next ${currentPage === total ? 'disabled' : ''}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>`;

      paginationEl.innerHTML = html;

      paginationEl.querySelectorAll('[data-pg1-page]').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentPage = parseInt(btn.dataset.pg1Page);
          console.log('pagination clicked');
          renderGrid();
          root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      const prevBtn = paginationEl.querySelector('[data-pg1-page-prev]');
      const nextBtn = paginationEl.querySelector('[data-pg1-page-next]');
      if (prevBtn)
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            renderGrid();
            root.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      if (nextBtn)
        nextBtn.addEventListener('click', () => {
          if (currentPage < total) {
            currentPage++;
            renderGrid();
            root.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
    } // -- renderPagination

    // optional #update_url

    // #bind-card-level-events

    function bindCardEvents() {
      gridEl.querySelectorAll('.pg1-card').forEach((card) => {
        // data-pg1-product-id
        const pid = parseInt(card.dataset.pg1ProductId); // data-pg1-product-id
        const product = allProducts.find((p)=> p.id === pid);
        if(!product) return;

       
       
        const images   = product.images.length ? product.images : [product.featuredImage];
        const sliderEl =  card.querySelector('[data-pg1-slider]'); // data-pg1-slider

        bindSlider(card, pid, images, sliderEl);
        bindWishlist(card,pid);
        bindSwatches(card, pid, product, images, sliderEl);
        bindATC(card, pid); 
        

      }); // card loop end
    } // bindCardEvents


    function bindSwatches(card, pid, product, images, sliderEl){
    //  console.log('bind swatches')
         card.querySelectorAll('[data-pg1-opt-idx]').forEach((swatch)=>{
        if(swatch.classList.contains("unavailable")) return;

        swatch.addEventListener("click", (e)=>{
          e.preventDefault();
          e.stopPropagation();
          
          const optIdx = parseInt(swatch.dataset.pg1OptIdx);
          const optVal = swatch.dataset.pg1OptVal;

          

          // Build Current Selections across all options
          const selections = {}
          product.options.forEach((_,i)=>{
            const active = card.querySelector(`[data-pg1-opt-idx="${i}"].active`)
            if(active) selections[i] = active.dataset.pg1OptVal;
           
          })

          selections[optIdx] = optVal;

          // find matching variant
        const match = product.variants.find((v) =>
          product.options.every(
            (_, i) => !selections[i] || v["option" + (i + 1)] === selections[i],
          ),
        );

        
      if(!match) return;

      // id_update
      const variantInput = card.querySelector("[data-pg1-variant-input]");
      if(variantInput) variantInput.value = match.id
      // console.log(variantInput)
    
      // update state 
      updateCardPrice(card, match);
      updateCardATC(card,match);
      updateCardBadges(card, match);
      
      if(match.featuredImage) {
        const imgIdx = images.indexOf(match.featuredImage);
        if(imgIdx > -1){
          cardSlides[pid] = imgIdx;
          sliderEl.style.transform = `translateX(-${imgIdx * 100}%)`
        }
      }
      
      // update active swatch
      card
          .querySelectorAll(`[data-pg1-opt-idx="${optIdx}"]`)
          .forEach((s)=> s.classList.remove("active"));

          swatch.classList.add("active");         

        }); // ******** event listener

        //********************
      });     
    }

    
     function updateCardPrice(card, variant){
        const isSale  = variant.compareAtPrice && variant.compareAtPrice > variant.price;
      //  console.log(isSale)

        // data-pg1-price
        card.querySelector("[data-pg1-price]").textContent = formatMoney(variant.price);
        const compareEl = card.querySelector("[data-pg1-compare]");
      //  console.log('compareEl:',compareEl)

        if(compareEl){
          compareEl.textContent = isSale ? formatMoney(variant.compareAtPrice):"";
          compareEl.style.display = isSale ? "" : "none"
        }       
    }

    function  updateCardATC(card,variant){
      const btn = card.querySelector("[data-pg1-atc-btn]");
      if(!btn) return;
      btn.disabled = !variant.available;
      btn.classList.toggle("sold-out", !variant.available);
      btn.textContent = variant.available ? "+ Add to Cart" : "Sold Out";
    }

   
    function  updateCardBadges(card, match){}

    // ********** swatch releted functin ends
       
    // #bindSlider
   function bindSlider(card,pid,images, sliderEl){
  //  console.log('bindSlider')
      function updateSlider(){
        const idx = cardSlides[pid] || 0;   // states-> cardSlides = {};
        // data-pg1-slide-prev | data-pg1-slide-next
   //   console.log(images)

        sliderEl.style.transform = `translateX(-${idx * 100}%)`;
        card.querySelector("[data-pg1-slide-prev]").disabled = idx === 0;                       // data-pg1-slide-prev
        card.querySelector("[data-pg1-slide-next]").disabled = idx >= images.length - 1;   

      }

      card.querySelector("[data-pg1-slide-prev]")?.addEventListener("click", (e)=> {
        e.preventDefault();
        e.stopPropagation();
        cardSlides[pid] = Math.max(0, (cardSlides[pid] || 0) - 1);
        updateSlider();
      })

      card.querySelector("[data-pg1-slide-next]")?.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        cardSlides[pid] = Math.min(images.length - 1, (cardSlides[pid] || 0) + 1);
        updateSlider();
      });
    }
  

     // #bindWishlist

    function bindWishlist(card, pid) {
   
    }


  

    {% comment %} #bindATC {% endcomment %}

   function bindATC(card, pid){
        // data-pg1-atc-form
        // data-pg1-atc-btn
        const form = card.querySelector("[data-pg1-atc-form]");
        const btn = card.querySelector("[data-pg1-atc-btn]");
        if( !form || !btn) return;

        form.addEventListener("submit", async (e)=>{
           e.preventDefault();
           e.stopPropagation();
           if (btn.disabled || btn.classList.contains("loading")) return
          const variantId = parseInt(
            card.querySelector("[data-pg1-variant-input]").value
            )
          
          if(!variantId){
            showToast("please select a variant.", true);
            return
          }

        //  clearTimeout(timeout);

          // loading 
          btn.classList.add("loading");
          btn.textContent = "Adding";
          btn.disalbed = true; 
          
          try{

            const cartDrawer = document.querySelector('cart-drawer-component');

            let formData = {
            'items': [{
              'id': variantId,
              'quantity': 1
              }],
              'sections': cartDrawer?.getSectionsToRender
                ? cartDrawer.getSectionsToRender().map((s) => s.id)
                : ['cart-drawer'],
              'sections_url': window.location.pathname,
            };
            const res = await fetch('/cart/add.js',{
              method:"POST",
              headers:{
                "Content-Type": "application/json",
                Accept: "application/json"
              },
              body: JSON.stringify(formData)
            })
            const data = await res.json();
            if (!res.ok) throw new Error(data.description || "Error");

          // Success
            btn.classList.remove("loading");
            btn.classList.add("added");
            btn.disabled = false;
            btn.textContent = "✓ Added!";
            setTimeout(() => {
              btn.classList.remove("added");
              btn.textContent = "+ Add to Cart";
          }, 2500);

          await refreshHorizonCart(data);
          console.log(CONFIG.cartBehavior)
          if (CONFIG.cartBehavior === "redirect") window.location.href = "/cart";
          else if (CONFIG.cartBehavior === "drawer") await openHorizonCartDrawer();
          showToast("✓ Added to cart");


          }catch(err){
             btn.classList.remove("loading");
            btn.disabled = false;
            btn.textContent = "+ Add to Cart";
            showToast("⚠ " + (err.message || "Could not add to cart."), true);
          }
        

        }) // eventlistener  
    }

    // 10 cart integration

    async function refreshHorizonCart(data) {
      // header-actions__cart-icon header-actions__cart-icon--has-cart
      // cart-bubble__text-count
      // data-testid
      // span -- class-- cart-bubble__text-count
      const cartIcon = document.querySelector('cart-icon.header-actions__cart-icon')
      const cartTextCount = cartIcon.querySelector('span.cart-bubble__text-count');
      const cartBuble     = cartIcon.querySelector(".cart-bubble");
      
      const res = await fetch('/cart.js', {
              headers: {accept: "application/json"}
      })

      const cart = await res.json();
     // console.log(cart);

      // update header icon
      cartTextCount.classList.remove("hidden")
      cartBuble.classList.remove("visually-hidden")
      setTimeout(()=>{
        cartTextCount.innerText = cart.item_count;
      }, 100)

      // update cart component
   

     
    } // refreshhorizon cart
    
    async   function openHorizonCartDrawer() {
    // 1. Horizon's product-form-component fires this event natively — replicate it
    document.documentElement.dispatchEvent(
      new CustomEvent('cart:refresh', { bubbles: true, detail: { openMiniCart: true } })
    );

   

    // 2. Try clicking the native cart icon/button to open the drawer
    const selectors = [
      '[data-cart-drawer-toggle]',
      '[data-open-cart]',
      'button[aria-controls="CartDrawer"]',
      '#CartDrawerToggle',
      '.js-cart-drawer-open',
      'header-drawer [data-cart]',
      'a[href="#cart-drawer"]'
    ];
    for (const sel of selectors) {
      const el = document.querySelector(sel);
      if (el) { el.click(); return; }
    }

    // 3. Try web component open() method
    const drawer = document.querySelector('cart-drawer-component');
    console.log(drawer)
    if (drawer) {      
      if (typeof drawer.open === 'function') { drawer.open(); return; }
    //  drawer.setAttribute('open', '');

    }else{
      console.log('drawer not found')
    }
  }

    {% comment %} #toast {% endcomment %}

    function showToast(msg, isError) {
      if (!toastEl) return;
      clearTimeout(toastTimer);
      toastEl.textContent = msg || '✓ Added to cart';
      toastEl.classList.toggle('error', !!isError);
      toastEl.classList.add('show');
      toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2400);
    }

    

    {% comment %} ************************************ {% endcomment %}
    // ##renderGrid();
    renderGrid();

    /****************************************************************/
    //// IFFE ENDS HERE
  })();
